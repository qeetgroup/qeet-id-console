{
  "name": "qeet-id-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "lint:boundaries": "biome lint --error-on-warnings ./src",
    "format": "biome format --write .",
    "check": "biome check --error-on-warnings .",
    "audit": "bun audit --audit-level=high",
    "new-module": "node scripts/new-module.mjs",
    "contract:sync": "node scripts/contract/sync.mjs",
    "contract:check": "node scripts/contract/check.mjs",
    "contract:drift": "node scripts/contract/drift.mjs",
    "sonar": "node scripts/sonar.mjs"
  },
  "dependencies": {
