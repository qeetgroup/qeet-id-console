# Qeet ID Admin — environment variables
# Copy this file to `.env.local` (gitignored) for local dev.
# Each value below is the local-dev default; the `# prod:` comment is the live value.
# Schema: src/platform/config/env.ts (PUBLIC_API_URL: src/platform/config/api-base-url.ts)

# --- Client (exposed to the browser, must be prefixed with VITE_) ---

# Window title and visible app name
VITE_APP_TITLE="Qeet ID Admin"

# Backend API base URL (used by fetch calls from the browser; the app appends /v1/... itself).
# prod: https://api.id.qeet.in
VITE_API_URL="http://localhost:4001"


# --- Server (Node-only, never sent to the browser) ---

# Internal server URL (SSR / server functions) — same host as the API.
# prod: https://api.id.qeet.in
# SERVER_URL="http://localhost:4001"

# The console's server calls the API for each person, so the API would see the
# console's address for everyone. With the same key the API has in RELAY_KEYS,
# the console names the person's address (X-Qeet-Client-IP), and the API's rate
# limits, sign-in lockout, address rules, sessions and audit use it. Server-only;
# never a VITE_ variable. Empty: no address is relayed.
# QEET_ID_RELAY_KEY=""
# Reverse proxies in front of the console that append to X-Forwarded-For (1 for
# one Caddy/nginx). 0: the connection's peer is the person.
# CONSOLE_TRUSTED_PROXY_HOPS=0

# Optional RUNTIME override of the browser-facing API origin (read per request,
# handed to the browser before hydration). Lets one container image serve any
# environment — the Qeet ID Kit (qeet-id-kit) sets it. Public, not a secret.
# PUBLIC_API_URL="http://localhost:4001"

# Encrypts and signs the HttpOnly console session. Required in production;
# generate at least 32 random characters and keep it server-only.
# SESSION_SECRET="replace-with-at-least-32-random-characters"


# --- Vercel auto-injected at deploy time — DO NOT set locally ---
# VERCEL=1                 ← "1" when running on Vercel
# VERCEL_ENV=production    ← "production" | "preview" | "development"
# VERCEL_URL=...           ← the deployment hostname
