{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noImportCycles": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "noStaticElementInteractions": "warn",
        "useAriaPropsSupportedByRole": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@qeetrix/ui": "The console is on @qeetrix/react: @qeetrix/ui was removed at the cut-over (2026-10-28)."
            },
            "patterns": []
          }
        },
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Backend traffic goes through api() (src/platform/api/client.ts) and the BFF; never fetch from a module or component.",
              "EventSource": "Streams go through the BFF stream routes (src/platform/api/server-stream.ts).",
              "WebSocket": "Backend traffic goes through the BFF (src/platform/api).",
              "XMLHttpRequest": "Backend traffic goes through api() (src/platform/api/client.ts)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/**",
                      "@/platform/**",
                      "@/routes/**",
                      "@/app/**",
                      "@/lib/**",
                      "@/config/**",
                      "@/components/**",
                      "@/integrations/**"
                    ],
                    "message": "shared/ is the lowest layer: import only @/shared, @/i18n, or external packages."
                  }
                ],
                "paths": {
                  "@qeetrix/ui": "The console is on @qeetrix/react: @qeetrix/ui was removed at the cut-over (2026-10-28)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/i18n/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@qeetrix/ui": "The console is on @qeetrix/react: @qeetrix/ui was removed at the cut-over (2026-10-28)."
                },
                "patterns": [
                  {
                    "group": [
                      "@/modules/**",
                      "@/platform/**",
                      "@/routes/**",
                      "@/shared/**",
                      "@/app/**"
                    ],
                    "message": "i18n/ holds locale resources and the i18next setup: it imports only external packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules/**", "@/routes/**", "@/app/**", "@/lib/**"],
                    "message": "platform/ may depend only on @/platform, @/shared, @/i18n (never modules, routes, app, or the retired @/lib)."
                  }
                ],
                "paths": {
                  "@qeetrix/ui": "The console is on @qeetrix/react: @qeetrix/ui was removed at the cut-over (2026-10-28)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/routes/**", "@/app/**"],
                    "message": "modules/ must not import routes or app."
                  },
                  {
                    "group": ["@/lib/**"],
                    "message": "@/lib is retired — import from the module/platform/shared home."
                  }
                ],
                "paths": {
                  "@qeetrix/ui": "The console is on @qeetrix/react: @qeetrix/ui was removed at the cut-over (2026-10-28)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/routes/**", "src/modules/*/routes/**", "!**/routes/**/-*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@qeetrix/ui": "The console is on @qeetrix/react: @qeetrix/ui was removed at the cut-over (2026-10-28).",
                  "@tanstack/react-query": "Routes compose; data access lives in the owning module (its hooks / queryOptions). Move this into the module.",
                  "@/platform/api/client": {
                    "importNames": ["api"],
                    "message": "Routes don't call the API. Move the request into the owning module's api/ and use its hook."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/modules/*/**", "!@/modules/*/pages", "!@/modules/*/entry-pages"],
                    "message": "A route imports its own module's pages relatively, another module through its barrel (@/modules/<name>) or route entry (@/modules/<name>/pages, or entry-pages for the pages already on @qeetrix/react), never internals."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/platform/api/**",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/test-setup.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/platform/components/data-state.tsx",
        "src/platform/components/status-pill.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/.source",
      "!**/.output",
      "!**/.tanstack",
      "!**/.nitro",
      "!**/.netlify",
      "!**/.vercel",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/routeTree.gen.ts",
      "!.claude",
      "!bun.lock"
    ]
  }
}
