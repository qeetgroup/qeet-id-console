{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noImportCycles": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "noStaticElementInteractions": "warn",
        "useAriaPropsSupportedByRole": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/**",
                      "@/platform/**",
                      "@/routes/**",
                      "@/app/**",
                      "@/lib/**",
                      "@/config/**",
                      "@/components/**",
                      "@/integrations/**"
                    ],
                    "message": "shared/ is the lowest layer: import only @/shared, @/i18n, or external packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules/**", "@/routes/**", "@/app/**", "@/lib/**"],
                    "message": "platform/ may depend only on @/platform, @/shared, @/i18n (never features, routes, app, or the retired @/lib)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/routes/**", "@/app/**"],
                    "message": "features/ must not import routes or app."
                  },
                  {
                    "group": ["@/modules/*/**"],
                    "message": "Import another feature via its public barrel (@/features/<name>), never its internals. Use a relative path for your own feature."
                  },
                  {
                    "group": ["@/lib/**"],
                    "message": "@/lib is retired — import from the feature/platform/shared home."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/.source",
      "!**/.output",
      "!**/.tanstack",
      "!**/.nitro",
      "!**/.netlify",
      "!**/.vercel",
      "!**/coverage",
      "!**/routeTree.gen.ts",
      "!bun.lock"
    ]
  }
}
